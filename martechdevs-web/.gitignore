# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pre-optimisation copies of public/assets (kept as a local backup, not shipped)
/_asset-originals

# generated preview stills for the service illustrations
scripts/illustrations/.preview/

# dev-only illustration lab, never shipped
public/_lab.html
# one illustration at 2x with each deck variant pinned, for judging spacing
public/_zoom.html
# the spacing and alignment audit, run from the console against the real page
public/_audit.js
